<view class="fp-card card" bindtap="onTap">
  <image class="card-bg" src="/assets/bg/card-paper-ink.jpg" mode="scaleToFill" />
  <view class="cover">
    <image
      wx:if="{{coverUrl}}"
      class="cover-img"
      src="{{coverUrl}}"
      mode="aspectFill"
      lazy-load="true"
    />
    <view wx:else class="cover-empty">无图</view>
  </view>
  <view class="body">
    <view class="place">
      <text class="place-text">{{record.place}}</text>
    </view>
    <view class="note">{{record.note}}</view>
    <view wx:if="{{record.draftStatus === 'syncing'}}" class="draft-badge draft-badge--syncing">
      <text>审核中 · 内容仅自己可见</text>
    </view>
    <view wx:elif="{{record.draftStatus === 'failed'}}" class="draft-badge">
      <text>{{record.draftError || '未保存成功'}} · 点击处理</text>
    </view>
  </view>
  <text class="card-arrow" aria-hidden="true">›</text>
</view>
