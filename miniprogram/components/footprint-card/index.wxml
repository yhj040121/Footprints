<view class="fp-card card" bindtap="onTap">
  <view class="cover">
    <image
      wx:if="{{coverUrl}}"
      class="cover-img"
      src="{{coverUrl}}"
      mode="aspectFill"
      lazy-load="true"
    />
    <view wx:else class="cover-empty">无图</view>
  </view>
  <view class="body">
    <view class="place">
      <text class="place-icon">⌖</text>
      <text class="place-text">{{record.place}}</text>
    </view>
    <view class="note">{{record.note}}</view>
    <!-- 草稿状态徽标（S8 乐观保存）：syncing=后台审核中 / failed=未保存成功，可点击恢复处理 -->
    <view wx:if="{{record.isDraft}}" class="draft-badge {{record.draftStatus === 'failed' ? 'draft-badge--failed' : ''}}">
      <text>{{record.draftStatus === 'failed' ? '未保存成功 · 点击处理' : '保存中…'}}</text>
    </view>
  </view>
</view>
