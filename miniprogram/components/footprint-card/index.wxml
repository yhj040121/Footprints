<view class="fp-card card" bindtap="onTap">
  <view class="cover">
    <image
      wx:if="{{coverUrl}}"
      class="cover-img"
      src="{{coverUrl}}"
      mode="aspectFill"
      lazy-load="true"
    />
    <view wx:else class="cover-empty">无图</view>
  </view>
  <view class="body">
    <view class="place">
      <text class="place-icon">⌖</text>
      <text class="place-text">{{record.place}}</text>
    </view>
    <view class="note">{{record.note}}</view>
    <!-- 后台保存过程保持无感；仅失败时提示并允许点击恢复处理 -->
    <view wx:if="{{record.isDraft && record.draftStatus === 'failed'}}" class="draft-badge">
      <text>{{record.draftError || '未保存成功'}} · 点击处理</text>
    </view>
  </view>
</view>
