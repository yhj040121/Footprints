.card {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  min-height: 224rpx;
  overflow: hidden;
  background: #FFFEF9;
  border: 0;
  border-radius: 24rpx;
}

/* V1.3：横版水墨背景层，scaleToFill 拉伸铺满整个卡片 */
.card-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.cover {
  position: relative;
  z-index: 1;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #EFE9DC;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A937F;
  font-size: 24rpx;
  border: 1rpx dashed #B4AB97;
  border-radius: 16rpx;
}

.body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.place {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #35322C;
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
}

.place-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.note {
  color: #6E685C;
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.draft-badge {
  margin-top: auto;
  align-self: flex-start;
  max-width: 100%;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-all;
  color: #8C3B2E;
  background: #F4E3DC;
  border: 1rpx solid #CBB8A8;
  border-radius: 999rpx;
}
