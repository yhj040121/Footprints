/* 通用足迹卡：横版水墨背景同时用于时间轴与日历记录列表。 */
.card {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  min-height: 224rpx;
  overflow: hidden;
  background: #FFFEF9;
  border: 0;
  border-radius: 24rpx;
}

/* 用户提供的横版水墨背景，完整铺满卡片。 */
.card-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.cover {
  position: relative;
  z-index: 1;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-img);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-subtle);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  font-size: 24rpx;
  border: 1rpx dashed var(--color-border-control);
  border-radius: var(--radius-img);
}

.body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-right: 34rpx;
}

/* 地点名称：系统字体 Semibold，不用楷体（§38.2） */
.place {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.place-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.note {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.draft-badge {
  margin-top: auto;
  align-self: flex-start;
  max-width: 100%;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-all;
  color: var(--color-accent);
  background: rgba(168, 71, 55, 0.08);
  border: 1rpx solid rgba(168, 71, 55, 0.22);
  border-radius: var(--radius-full);
}

.draft-badge--syncing {
  color: #6E654F;
  background: rgba(145, 126, 82, 0.09);
  border-color: rgba(145, 126, 82, 0.22);
}

.card-arrow {
  position: absolute;
  z-index: 1;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #302D28;
  font-size: 50rpx;
  font-weight: 500;
  line-height: 1;
}
