.card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  /* 组件样式隔离：app.wxss 进不来，卡片表面在此自写（否则透明卡会透出左滑操作层） */
  background: #FFFEF9;
  border: 1rpx solid #E2DACA;
  border-radius: 24rpx;
}

.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #EFE9DC;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9A937F;
  font-size: 24rpx;
  border: 1rpx dashed #B4AB97;
  border-radius: 16rpx;
}

.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.place {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #35322C;
}

.place-icon {
  font-size: 26rpx;
}

.place-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.note {
  color: #6E685C;
  font-size: 26rpx;
  line-height: 1.5;
  /* FR-08：备注恰好 2 行截断 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 仅展示失败状态；正常后台保存不显示过程状态 */
.draft-badge {
  margin-top: auto;
  align-self: flex-start;
  max-width: 100%;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-all;
  color: #8C3B2E;
  background: #F4E3DC;
  border: 1rpx solid #CBB8A8;
  border-radius: 999rpx;
}
