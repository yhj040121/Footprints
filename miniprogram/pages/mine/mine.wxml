<!-- pages/mine/mine.wxml —— 我的 Tab（FR-14） -->
<view class="mine">
  <image class="page-bg" src="/assets/bg/page-paper-ink.jpg" mode="aspectFill" />
  <mock-badge />

  <!-- 头像与昵称 -->
  <view class="profile">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
      <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFit" />
      <view wx:else class="avatar avatar--empty">旅</view>
    </button>
    <input class="nickname" type="nickname" value="{{nickname}}" placeholder="旅人" maxlength="32"
      placeholder-class="nickname-ph" bindblur="onNicknameBlur" bindconfirm="onNicknameBlur" />
    <view class="fp-hint">轻触头像或昵称可修改</view>
  </view>

  <!-- 统计三项 -->
  <view class="stats fp-card">
    <view class="stat">
      <text class="stat-num">{{stats.days}}</text>
      <text class="stat-label">已记录天数</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat">
      <text class="stat-num">{{stats.footprints}}</text>
      <text class="stat-label">足迹数</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat">
      <text class="stat-num">{{stats.photos}}</text>
      <text class="stat-label">照片张数</text>
    </view>
  </view>

  <!-- 功能列表：导出照片 / 关于我们 -->
  <view class="menu fp-card">
    <view class="menu-item" hover-class="menu-item--hover" bindtap="onExportTap">
      <text class="menu-icon">⇊</text>
      <text class="menu-text">导出照片到相册</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-line"></view>
    <view class="menu-item" hover-class="menu-item--hover" bindtap="onSettingsTap">
      <text class="menu-icon">ⓘ</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 头像压缩隐藏画布 -->
  <canvas type="2d" id="avatarCanvas" class="hidden-canvas" />

  <!-- 关于我们：平台简介与版本号 -->
  <view wx:if="{{showSettings}}" class="mask" bindtap="onSettingsClose">
    <view class="panel fp-card" catchtap="noop">
      <view class="panel-title">关于我们</view>
      <view class="settings-label">平台简介</view>
      <view class="settings-text">溪山行旅是一款专注于私人旅行足迹记录的小程序，帮助你按时间、日历和地图整理走过的地方与沿途照片。</view>
      <view class="settings-label">版本号</view>
      <view class="settings-text">V1.0.0</view>
      <button class="fp-btn-primary" bindtap="onSettingsClose">关闭</button>
    </view>
  </view>
</view>
