/* pages/mine/mine.wxss —— 我的页（水墨暖纸色，仅复用 app.wxss token） */

.mine {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: var(--space-5) var(--space-4) calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- 头像与昵称 ---------- */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-4) 0 var(--space-6);
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: var(--color-bg-subtle);
  border: 1rpx solid var(--color-border-subtle);
  line-height: 1;
  border-radius: var(--radius-full);
}
.avatar-btn::after { border: none; }

.avatar {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-subtle);
}
.avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-subtle);
  color: var(--color-text-muted);
  font-size: var(--text-2xl);
}

.nickname {
  margin-top: var(--space-3);
  min-height: 64rpx;
  text-align: center;
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--color-text-primary);
}
.nickname-ph { color: var(--color-text-muted); }

/* ---------- 统计三项 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-text-primary);
}
.stat-label {
  margin-top: var(--space-1);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}
.stat-sep {
  width: 1rpx;
  height: 64rpx;
  background: var(--color-border-subtle);
}

/* ---------- 功能列表 ---------- */
.menu {
  margin-top: var(--space-4);
  padding: 0 var(--space-4);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
}
.menu-item--hover { background: var(--color-bg-hover); }
.menu-icon {
  width: 64rpx;
  font-size: 36rpx;
  color: var(--color-text-secondary);
}
.menu-text {
  flex: 1;
  font-size: var(--text-base);
  color: var(--color-text-primary);
}
.menu-arrow {
  font-size: 40rpx;
  color: var(--color-text-muted);
}
.menu-line {
  height: 1rpx;
  background: var(--color-border-subtle);
}

/* ---------- 弹层（关于我们的浮窗） ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 620rpx;
  padding: var(--space-5) var(--space-4) var(--space-4);
}
.panel-title {
  margin-bottom: var(--space-4);
  text-align: center;
  font-size: var(--text-lg);
  font-weight: 500;
}

.settings-label {
  margin-bottom: var(--space-1);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.settings-text {
  margin-bottom: var(--space-4);
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--color-text-primary);
}

/* ---------- 头像压缩隐藏画布 ---------- */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 256px;
  height: 256px;
}
