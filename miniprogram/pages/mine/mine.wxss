/* pages/mine/mine.wxss —— 我的页（需求文档 §33-§37：Profile / 统计卡 / 水墨胶囊功能条） */

.mine {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-5) calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- Profile（§34：头像顶部 68~80rpx、156~164rpx；昵称上距 24rpx、40rpx；提示 24~25rpx） ---------- */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 0 56rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background: var(--color-bg-subtle);
  border: 1rpx solid var(--color-border-subtle);
  line-height: 1;
  border-radius: var(--radius-full);
}
.avatar-btn::after { border: none; }

.avatar {
  display: block;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-subtle);
}
.avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-subtle);
  color: var(--color-text-muted);
  font-size: var(--text-2xl);
}

.nickname {
  margin-top: 24rpx;
  min-height: 64rpx;
  width: 100%;
  text-align: center;
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}
.nickname-ph { color: var(--color-text-muted); }

.profile-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
}

/* ---------- 统计三项（§35：高 190~196rpx、左右边距 36~40rpx、圆角 30rpx、数字 48~52rpx/600） ---------- */
.stats {
  display: flex;
  align-items: center;
  min-height: 192rpx;
  padding: var(--space-4) 0;
  border-radius: var(--radius-xl);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.stat-num {
  font-size: 50rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--color-text-primary);
}
.stat-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
/* 分割线：1rpx × 72rpx，#DCCFBC（§35.1） */
.stat-sep {
  width: 1rpx;
  height: 72rpx;
  background: #DCCFBC;
}

/* ---------- 水墨胶囊功能条（§36：高 112~120rpx、圆角 999rpx、间距 28~32rpx） ---------- */
.entry {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  margin-top: 30rpx;
  padding: 0 var(--space-4);
}
.entry--hover { background: rgba(240, 234, 222, 0.94); }
.entry-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--space-3);
  flex-shrink: 0;
}
.entry-text {
  flex: 1;
  min-width: 0;
  font-size: var(--text-base);
  color: var(--color-text-primary);
}
/* CSS 绘制箭头（替代 Unicode ›） */
.entry-arrow {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  margin-left: var(--space-2);
}
.entry-arrow::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--color-text-muted);
  border-right: 3rpx solid var(--color-text-muted);
  transform: translate(-62%, -50%) rotate(45deg);
  border-radius: 1rpx;
}

/* ---------- 弹层（§37 关于我们：暖白纸面、圆角 28rpx、弱边） ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 620rpx;
  padding: var(--space-5) var(--space-4) var(--space-4);
  background: rgba(253, 251, 246, 0.98);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 48, 38, 0.08);
}
.panel-title {
  margin-bottom: var(--space-4);
  text-align: center;
  font-size: var(--text-lg);
  font-weight: 500;
}

.settings-label {
  margin-bottom: var(--space-1);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.settings-text {
  margin-bottom: var(--space-4);
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--color-text-primary);
}

/* ---------- 头像压缩隐藏画布 ---------- */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 256px;
  height: 256px;
}
