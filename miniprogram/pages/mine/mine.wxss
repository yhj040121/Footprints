/* pages/mine/mine.wxss —— 我的页（水墨暖纸色，仅复用 app.wxss token；无阴影/渐变/彩色状态色） */

.mine {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: var(--space-5) var(--space-4) calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- 头像与昵称 ---------- */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-4) 0 var(--space-6);
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
  border-radius: var(--radius-full);
}
.avatar-btn::after { border: none; }

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-border-subtle);
}
/* 未设置头像：灰圆占位 */
.avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-subtle);
  color: var(--color-text-muted);
  font-size: var(--text-2xl);
}

.nickname {
  margin-top: var(--space-3);
  min-height: 64rpx;
  text-align: center;
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--color-text-primary);
}
.nickname-ph { color: var(--color-text-muted); }

/* ---------- 统计三项 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-text-primary);
}
.stat-label {
  margin-top: var(--space-1);
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
}
.stat-sep {
  width: 1rpx;
  height: 64rpx;
  background: var(--color-border-subtle);
}

/* ---------- 功能列表 ---------- */
.menu {
  margin-top: var(--space-4);
  padding: 0 var(--space-4);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx; /* ≥88rpx 触控目标 */
}
.menu-item--hover { background: var(--color-bg-hover); }
.menu-icon {
  width: 64rpx;
  font-size: 36rpx;
  color: var(--color-text-secondary);
}
.menu-text {
  flex: 1;
  font-size: var(--text-base);
  color: var(--color-text-primary);
}
.menu-arrow {
  font-size: 40rpx;
  color: var(--color-text-muted);
}
.menu-line {
  height: 1rpx;
  background: var(--color-border-subtle);
}

/* ---------- 底部私密文案 ---------- */
.footer {
  margin-top: auto;
  padding: var(--space-6) 0 180rpx; /* 底部留白避开自定义 tabBar */
  text-align: center;
}

/* ---------- 弹层（遮罩 + 卡片） ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 620rpx;
  padding: var(--space-5) var(--space-4) var(--space-4);
}
.panel-title {
  margin-bottom: var(--space-4);
  text-align: center;
  font-size: var(--text-lg);
  font-weight: 500;
}

/* 日期范围选择 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: var(--space-3);
  padding: 0 var(--space-3);
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: var(--radius-md);
}
.picker-value { color: var(--color-text-secondary); }
.range-hint {
  margin-bottom: var(--space-4);
  text-align: center;
}
.panel-btns { display: flex; }
.panel-btn { flex: 1; }
.panel-btn + .panel-btn { margin-left: var(--space-3); }

/* 导出进度 */
.progress-num {
  margin-bottom: var(--space-3);
  text-align: center;
  font-size: var(--text-xl);
  font-weight: 500;
}
.progress-track {
  height: 12rpx;
  margin-bottom: var(--space-5);
  background: var(--color-bg-subtle);
  border-radius: var(--radius-full);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--color-action-bg);
  border-radius: var(--radius-full);
  transition: width var(--duration-normal);
}

/* 设置弹层 */
.settings-label {
  margin-bottom: var(--space-1);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.settings-text {
  margin-bottom: var(--space-4);
  font-size: var(--text-base);
  line-height: 1.6;
  color: var(--color-text-primary);
}

/* 头像压缩隐藏画布 */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 640px;
  height: 640px;
}
