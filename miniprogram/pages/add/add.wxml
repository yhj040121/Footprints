<!-- 新增/编辑足迹（FR-03~07 / FR-13 / V1.3 位置交互）：照片九宫格 + 表单 + 保存全链路 -->
<view class="page">
  <image class="page-bg" src="/assets/bg/page-paper-ink.jpg" mode="aspectFill" />
  <mock-badge />

  <view wx:if="{{isEdit}}" class="edit-bar">
    <text>正在编辑这条足迹</text>
    <text class="edit-cancel" bindtap="onCancelEdit">取消编辑</text>
  </view>

  <view class="photo-grid">
    <view class="photo-cell" wx:for="{{photos}}" wx:key="uid">
      <image class="photo-img" src="{{item.url}}" mode="aspectFill" wx:if="{{item.url}}" />
      <view class="photo-img photo-img--empty" wx:else></view>

      <view wx:if="{{item.status === 'uploading'}}" class="photo-mask">{{item.progress}}%</view>
      <view wx:elif="{{item.status === 'review-failed'}}" class="photo-mask photo-mask--bad">未通过</view>
      <view wx:elif="{{item.status === 'upload-failed'}}" class="photo-mask photo-mask--bad" catchtap="onPhotoRetry" data-uid="{{item.uid}}">失败 · 重试</view>

      <view wx:if="{{!saving}}" class="photo-del" catchtap="onRemovePhoto" data-uid="{{item.uid}}">✕</view>
    </view>

    <view wx:if="{{photos.length < maxPhotos && !saving}}" class="photo-cell photo-add" bindtap="onAddPhotos">
      <view class="photo-add-icon">＋</view>
      <view class="photo-add-text">添加照片</view>
    </view>
  </view>

  <view class="fp-card field-card">
    <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDateChange" disabled="{{saving}}">
      <view class="field-row">
        <text class="field-label">日期</text>
        <view class="field-value">
          <text>{{dateText}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 地点（V1.3）：并列「获取当前位置 / 选择位置」；修改名称/地区不动坐标；重新选择才动坐标 -->
  <view class="fp-card field-card location-card">
    <view class="field-label location-title">地点</view>
    <input
      class="location-name-input"
      value="{{place}}"
      maxlength="50"
      placeholder="为这次旅行记录一个位置"
      placeholder-class="ph"
      bindinput="onPlaceInput"
      bindblur="onPlaceBlur"
      disabled="{{saving}}"
    />

    <view wx:if="{{hasCoord}}" class="location-selected">
      <view class="region-line">
        <text>{{province || '地区待补充'}}</text>
        <text wx:if="{{city}}"> · {{city}}</text>
        <text wx:if="{{district}}"> · {{district}}</text>
      </view>
      <view class="city-label">足迹归属：{{cityLabel || '待补充'}}</view>
      <view class="location-actions">
        <button class="fp-btn-plain loc-action" bindtap="onOpenRegionEditor" disabled="{{saving}}">修改地区</button>
        <button class="fp-btn-plain loc-action" bindtap="onReselectLocation" disabled="{{saving}}">重新选择</button>
      </view>
    </view>
    <view wx:else class="location-empty-copy">获取现场位置，或在地图中补录过去的旅程</view>

    <view class="location-status">
      <text wx:if="{{placeError}}" class="field-error">{{placeError}}</text>
      <text wx:elif="{{placeHint}}" class="field-hint">{{placeHint}}</text>
      <text wx:elif="{{locationResolving}}" class="fp-hint">正在识别地点与地区…</text>
    </view>

    <view wx:if="{{!hasCoord}}" class="location-actions location-actions--primary">
      <button class="fp-btn-plain loc-action" bindtap="onGetCurrentLocation" loading="{{locationResolving}}" disabled="{{saving || locationResolving}}">获取当前位置</button>
      <button class="fp-btn-plain loc-action" bindtap="onChooseLocation" disabled="{{saving || locationResolving}}">选择位置</button>
    </view>
  </view>

  <view class="fp-card field-card">
    <view class="field-label note-label">备注</view>
    <textarea
      class="note-input"
      value="{{note}}"
      maxlength="{{maxNoteLen}}"
      placeholder="记录此刻的心境与风景…"
      placeholder-class="ph"
      bindinput="onNoteInput"
      bindblur="onNoteBlur"
      disabled="{{saving}}"
      auto-height
    />
    <view class="note-foot">
      <text wx:if="{{noteError}}" class="field-error">{{noteError}}</text>
      <text wx:elif="{{noteHint}}" class="field-hint">{{noteHint}}</text>
      <text class="note-count">{{noteLen}}/{{maxNoteLen}}</text>
    </view>
  </view>

  <button class="fp-btn-primary save-btn" bindtap="onSave" disabled="{{saving || locationResolving}}">
    {{isEdit ? '保存修改' : '保存'}}
  </button>

  <!-- 行政地区修正弹层：仅改文本归属，不修改经纬度 -->
  <view wx:if="{{showRegionEditor}}" class="mask" catchtouchmove="noop" bindtap="onRegionEditorCancel">
    <view class="panel fp-card region-panel" catchtap="noop">
      <view class="panel-title">修改行政地区</view>
      <input class="panel-input" data-field="province" value="{{regionDraft.province}}" maxlength="30" placeholder="省 / 直辖市" bindinput="onRegionDraftInput" />
      <input class="panel-input" data-field="city" value="{{regionDraft.city}}" maxlength="30" placeholder="城市" bindinput="onRegionDraftInput" />
      <input class="panel-input" data-field="district" value="{{regionDraft.district}}" maxlength="30" placeholder="区 / 县" bindinput="onRegionDraftInput" />
      <input class="panel-input" data-field="cityLabel" value="{{regionDraft.cityLabel}}" maxlength="30" placeholder="足迹归属（例如：嘉兴）" bindinput="onRegionDraftInput" />
      <view class="fp-hint region-hint">修改地区不会改变地图坐标</view>
      <view class="panel-btns">
        <button class="fp-btn-plain panel-btn" bindtap="onRegionEditorCancel">取消</button>
        <button class="fp-btn-primary panel-btn" bindtap="onRegionEditorSave">保存地区</button>
      </view>
    </view>
  </view>
</view>
