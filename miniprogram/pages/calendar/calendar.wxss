/* FR-09 日历视图：水墨暖纸色 token，无阴影 */

.page {
  /* 底部留白避开固定 tabBar */
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 顶部：年月 + 左右切换 */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-4) 0;
}

.cal-arrow {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: var(--text-2xl);
  border-radius: var(--radius-full);
}

.cal-arrow--hover {
  background: var(--color-bg-hover);
}

.cal-title {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 表头 */
.week-row {
  display: flex;
  padding: var(--space-3) var(--space-4) var(--space-1);
}

.week-cell {
  flex: 1;
  text-align: center;
  color: var(--color-text-muted);
  font-size: var(--text-sm);
}

/* 42 格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 var(--space-4);
}

.cell {
  width: calc(100% / 7);
  padding: 4rpx;
}

.cell-inner {
  position: relative;
  min-height: 96rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  overflow: hidden;
}

.cell-thumb {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 有首图但签名 URL 未就绪：呼吸占位，避免格子空白 */
.cell-thumb--loading {
  background: var(--color-bg-hover);
  animation: cell-loading-breathe 1.2s ease-in-out infinite;
}

@keyframes cell-loading-breathe {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 0.9; }
}

.cell-day {
  position: relative;
  font-size: var(--text-sm);
  color: var(--color-text-primary);
}

.cell-inner--muted .cell-day {
  color: var(--color-text-disabled);
}

.cell-inner--today {
  border-color: var(--color-action-bg);
}

.cell-inner--selected {
  border-color: var(--color-border-control);
  background: var(--color-bg-hover);
}

.cell-dot {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-action-bg);
}

/* 图例 */
.legend {
  padding: var(--space-2) var(--space-5) 0;
}

/* 当日记录 */
.day-head {
  padding: var(--space-4) var(--space-5) var(--space-3);
}

.day-title {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.day-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: 0 var(--space-4);
}

.day-empty {
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
