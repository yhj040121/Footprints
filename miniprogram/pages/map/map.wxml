<!-- 足迹地图（需求文档 §21-§32 重构）：
     Layer 1 微信真实地图 → Layer 2 暖纸中和层 → Layer 3 局部透明水墨山体/飞鸟 → Layer 4 Marker/控件/详情卡。
     不再用一张 page-paper-ink.jpg 盖满整张地图；Marker 去掉白色胶囊，改为圆形照片 + 墨线 + 墨点锚点。 -->
<view class="map-page">
  <mock-badge />
  <map id="footprintMap" class="map"
       latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}"
       include-points="{{includePoints}}" markers="{{markers}}" polyline="{{polyline}}"
       bindmarkertap="onMarkerTap" bindcallouttap="onCalloutTap"
       bindtap="onMapTap" bindregionchange="onRegionChange">
    <cover-view slot="callout">
      <cover-view wx:for="{{markerViews}}" wx:key="recordId" marker-id="{{item.markerId}}"
                  class="marker-callout marker-callout--{{item.side}} {{item.selected ? 'marker-callout--selected' : ''}}">
        <cover-view class="marker-card">
          <cover-image wx:if="{{item.photoUrl}}" class="marker-photo" src="{{item.photoUrl}}" />
          <cover-image wx:else class="marker-photo marker-photo--fallback" src="/assets/map/marker-fallback.png" />
          <cover-view class="marker-copy">
            <cover-view class="marker-place">{{item.place}}</cover-view>
            <cover-view class="marker-meta">{{item.meta}}</cover-view>
          </cover-view>
        </cover-view>
        <!-- 短墨线：向下连接坐标墨点（小墨点 marker-dot 才代表真实坐标） -->
        <cover-view class="marker-line"></cover-view>
      </cover-view>
    </cover-view>
  </map>

  <!-- Layer 2：暖纸中和层，压低地图高饱和色但保留道路/城市可读性（§23） -->
  <view class="map-veil"></view>

  <!-- Layer 3：局部透明水墨，极淡、位于内容后方（§24） -->
  <image class="map-ink map-ink--left" src="/assets/map/map-left.png" mode="heightFix" />
  <image class="map-ink map-ink--bottom" src="/assets/map/map-bottom.png" mode="widthFix" />
  <image class="map-ink map-ink--birds" src="/assets/map/map-birds.png" mode="widthFix" />

  <!-- Layer 4：品牌导航 + 统计信息带 + 控件 + 详情卡 -->
  <ink-navbar title-image="/assets/titles/map-title.png" />

  <view class="map-stats" style="top: {{statsTop}}px;">
    <image class="stat-icon" src="/assets/icons/footprint-ink.png" mode="aspectFit" />
    <view class="stat-item"><text>{{footprintCount}} 处足迹</text></view>
    <text class="stat-dot">·</text>
    <image class="stat-icon" src="/assets/icons/city-ink.png" mode="aspectFit" />
    <view class="stat-item"><text>{{cityCount}} 座城市</text></view>
    <text class="stat-dot">·</text>
    <image class="stat-icon" src="/assets/icons/location-ink.png" mode="aspectFit" />
    <view class="stat-item stat-recent"><text>最近：{{recentRegion}}</text></view>
    <button class="route-info" bindtap="onRouteInfoTap" aria-label="足迹连线说明">
      <image class="route-info__icon" src="/assets/icons/help-ink.png" mode="aspectFit" />
    </button>
  </view>

  <view wx:if="{{empty}}" class="empty-hint">
    <text class="empty-title">还没有留下足迹</text>
    <text class="empty-desc">记录一次旅行后，它会出现在这里</text>
  </view>
  <view wx:if="{{mapError}}" class="empty-hint">
    <text class="empty-title">地图暂时没有加载出来</text>
    <text class="empty-desc">请稍后再试</text>
  </view>

  <!-- 定位墨圈（§29：不规则墨圈 + 准星素材，文字仍由 WXML 绘制） -->
  <button class="locate-btn {{card ? 'locate-btn--up' : ''}}" bindtap="onLocate" loading="{{locating}}" hover-class="locate-btn--hover" aria-label="定位我">
    <image class="locate-btn__bg" src="/assets/map/locate-ink.png" mode="aspectFit" />
    <text class="locate-btn__text">定位我</text>
  </button>

  <!-- 底部浮动详情卡（§30：Floating Surface + 轻阴影；§31 查看记录用墨刷按钮） -->
  <view wx:if="{{card}}" class="map-card">
    <image wx:if="{{card.thumb}}" class="card-thumb" src="{{card.thumb}}" mode="aspectFill" />
    <view class="card-body">
      <view class="card-headline">
        <view class="card-copy">
          <text class="card-place">{{card.place}}</text>
          <text wx:if="{{card.regionText}}" class="card-region">{{card.regionText}}</text>
          <text class="card-meta">{{card.dateText}}　{{card.photoCount}}张照片</text>
        </view>
        <button class="brush-btn view-record" bindtap="onCardTap">
          <image class="brush-btn__bg" src="/assets/buttons/brush-dark.png" mode="scaleToFill" />
          <text class="brush-btn__text">查看记录</text>
        </button>
      </view>
      <view wx:if="{{card.previews.length}}" class="preview-row">
        <image wx:for="{{card.previews}}" wx:key="*this" class="preview-img" src="{{item}}" mode="aspectFill" />
        <view wx:if="{{card.moreCount > 0}}" class="preview-more">+{{card.moreCount}}</view>
      </view>
    </view>
  </view>
</view>
