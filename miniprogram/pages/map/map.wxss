/* 足迹地图页（需求文档 §21-§32）：真实地图 + 暖纸中和层 + 局部透明水墨 + 轻统计带
   + 透明 Marker（圆形照片/墨线/墨点）+ 墨圈定位 + 浮动详情卡 + 墨刷按钮 */
.map-page {
  --map-paper: #F6F2E9;
  --map-wash: rgba(248, 245, 237, 0.46);
  --map-ink-opacity: 1;
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: var(--map-paper);
}

.map {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ---------- 纯视觉穿透层：普通同层节点，不参与任何地图/按钮触摸命中 ---------- */
.map-visual-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 20;
  pointer-events: none !important;
  overflow: hidden;
}
.map-visual-layer view,
.map-visual-layer image {
  pointer-events: none !important;
}
.map-veil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(248, 245, 237, 0.28) 0%, transparent 22%), var(--map-wash);
}

/* ---------- 局部水墨：只占边缘，中心道路/城市/照片墨钉保持可读 ---------- */
.map-ink {
  position: absolute;
  pointer-events: none;
  opacity: var(--map-ink-opacity);
}
.map-ink--left {
  left: -42rpx;
  top: 27%;
  width: 360rpx;
  height: 620rpx;
}
.map-ink--bottom {
  left: -30rpx;
  bottom: 120rpx;
  width: calc(100% + 60rpx);
  height: 300rpx;
  opacity: 1;
}
.map-ink--birds {
  right: 38rpx;
  top: 244rpx;
  width: 144rpx;
  height: 72rpx;
  opacity: 0.56;
}

/* ---------- 顶部统计栏（§26：轻量宣纸信息带，高 70~76rpx，rgba(248,245,237,.72)，无明显边框） ---------- */
.map-stats {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 0;
  height: 82rpx;
  padding: 0 18rpx;
  border-radius: 0;
  background: rgba(248, 245, 237, 0.90);
  box-shadow: 0 1rpx 0 rgba(85, 76, 63, 0.08), 0 8rpx 20rpx rgba(55, 48, 38, 0.03);
  font-size: 25rpx;
  color: var(--color-text-primary);
  z-index: 50;
}
.stat-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.72;
  flex-shrink: 0;
}
.stat-icon--mountain {
  width: 46rpx;
  height: 38rpx;
  opacity: 0.68;
}
.stat-cluster {
  display: flex;
  align-items: center;
  gap: 7rpx;
  flex: 0 1 auto;
  min-width: 0;
}
.stat-cluster + .stat-cluster {
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid rgba(91, 78, 57, 0.18);
}
.stat-label {
  color: #49443B;
  line-height: 1;
  white-space: nowrap;
}
.stat-recent {
  flex: 1;
  min-width: 0;
}
.stat-label--recent {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
@media (max-width: 350px) {
  .map-stats { padding: 0 12rpx; font-size: 22rpx; }
  .stat-cluster { gap: 4rpx; }
  .stat-cluster + .stat-cluster { margin-left: 9rpx; padding-left: 9rpx; }
  .stat-icon { width: 29rpx; height: 29rpx; }
  .stat-icon--mountain { width: 38rpx; height: 32rpx; }
}

/* ---------- Marker callout（§27：无白色胶囊，完全透明背景；圆形照片 + 地点文字 + 短墨线） ---------- */
.marker-callout {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  white-space: nowrap;
}
.marker-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  background: transparent;
  border: none;
  padding: 0;
}
.marker-callout--left .marker-card { flex-direction: row-reverse; }
.marker-photo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(58, 54, 47, 0.28); /* 极淡墨边（§27.2） */
  background: #EFE9DC;
  box-shadow: 0 0 0 4rpx rgba(248, 245, 237, 0.55); /* 极淡宣纸描边 */
}
.marker-photo--fallback { opacity: 0.8; }
.marker-callout--selected .marker-photo {
  width: 86rpx;
  height: 86rpx;
  border-color: rgba(58, 54, 47, 0.72);
  box-shadow: 0 0 0 5rpx rgba(248, 245, 237, 0.76), 0 8rpx 20rpx rgba(48, 45, 40, 0.16);
}
.marker-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: transparent;
}
/* 地点名 26~28rpx/600、日期 22~24rpx（§27.4），无白色气泡 */
.marker-place {
  font-size: 27rpx;
  font-weight: 600;
  color: #302D28;
  text-shadow: 0 0 7rpx rgba(248, 245, 237, 1), 0 1rpx 0 rgba(248, 245, 237, 1);
}
.marker-meta {
  font-size: 23rpx;
  color: #55503F;
  text-shadow: 0 0 7rpx rgba(248, 245, 237, 1), 0 1rpx 0 rgba(248, 245, 237, 1);
}
/* 短墨线：照片下方，向下连接坐标墨点（§27.3） */
.marker-line {
  width: 2rpx;
  height: 20rpx;
  margin-top: 2rpx;
  background: rgba(58, 54, 47, 0.62);
  border-radius: 2rpx;
}

/* ---------- 空态 / 错误态（§32：小片宣纸，不用明显大白卡） ---------- */
.empty-hint {
  position: absolute;
  top: 38%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(248, 245, 237, 0.88);
  z-index: 50;
  text-align: center;
}
.empty-title { font-size: 28rpx; color: var(--color-text-primary); font-weight: 500; }
.empty-desc { font-size: 22rpx; color: var(--color-text-muted); }

/* ---------- 定位按钮：使用完整水墨按钮素材 ---------- */
.locate-btn {
  position: absolute;
  right: var(--space-4);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: var(--radius-full);
  background: transparent;
  border: 0;
  box-shadow: none;
  line-height: 1;
  z-index: 50;
}
.locate-btn::after { border: none; }
.locate-btn--hover { opacity: 0.78; }
.locate-btn--up {
  bottom: calc(480rpx + env(safe-area-inset-bottom));
}
.locate-btn__image {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---------- 底部浮动详情卡（§30：Floating Surface，高 220~232rpx，圆角 28~32rpx） ---------- */
.map-card {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: stretch;
  min-height: 226rpx;
  padding: 20rpx;
  gap: 18rpx;
  background: rgba(253, 251, 246, 0.94);
  border: 1rpx solid rgba(85, 76, 63, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 48, 38, 0.08);
  z-index: 50;
}
.card-thumb {
  flex: none;
  width: 152rpx;
  height: 152rpx;
  align-self: center;
  border-radius: var(--radius-img);
  background: #E9E2D5;
}
.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.card-headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.card-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.card-place {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-region {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-meta { font-size: 22rpx; color: var(--color-text-muted); }

/* 查看记录：使用用户提供的完整水墨按钮素材。 */
.view-record {
  flex: none;
  width: 176rpx;
  height: 59rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx 0 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 30rpx;
  box-shadow: none;
  line-height: 1;
}
.view-record::after { border: 0; }
.view-record--hover { opacity: 0.78; }
.view-record__image { display: block; width: 100%; height: 100%; }

.preview-row {
  display: flex;
  gap: 8rpx;
  margin-top: auto;
}
.preview-img, .preview-more {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx;
  background: #E7E0D4;
}
.preview-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: rgba(90, 80, 64, 0.08);
}
