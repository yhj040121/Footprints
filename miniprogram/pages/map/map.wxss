/* 足迹地图页（需求文档 §21-§32）：真实地图 + 暖纸中和层 + 局部透明水墨 + 轻统计带
   + 透明 Marker（圆形照片/墨线/墨点）+ 墨圈定位 + 浮动详情卡 + 墨刷按钮 */
.map-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* ---------- Layer 2：暖纸中和层（§23：rgba(246,243,235,.35~.50)，压低绿色/道路橙） ---------- */
.map-veil {
  position: absolute;
  inset: 0;
  background: rgba(246, 243, 235, 0.42);
  pointer-events: none;
  z-index: 1;
}

/* ---------- Layer 3：局部透明水墨（§24：不铺满，分别定位） ---------- */
.map-ink {
  position: absolute;
  pointer-events: none;
  z-index: 2;
  opacity: 0.8;
}
.map-ink--left {
  left: 0;
  top: 20%;
  height: 56%;
  width: 200rpx;
}
.map-ink--bottom {
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
}
.map-ink--birds {
  right: 40rpx;
  top: 220rpx;
  width: 180rpx;
}

/* ---------- 顶部统计栏（§26：轻量宣纸信息带，高 70~76rpx，rgba(248,245,237,.72)，无明显边框） ---------- */
.map-stats {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-full);
  background: rgba(248, 245, 237, 0.72);
  font-size: 24rpx;
  color: var(--color-text-primary);
  z-index: 50;
}
.stat-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.8;
  flex-shrink: 0;
}
.stat-item { display: inline-flex; align-items: center; }
.stat-dot { color: var(--color-text-muted); }
.stat-recent { color: var(--color-text-secondary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.route-info {
  margin-left: auto;
  width: 44rpx; height: 44rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: rgba(90, 80, 64, 0.08);
}
.route-info::after { border: 0; }
.route-info__icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.8;
}

/* ---------- Marker callout（§27：无白色胶囊，完全透明背景；圆形照片 + 地点文字 + 短墨线） ---------- */
.marker-callout {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  white-space: nowrap;
}
.marker-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  background: transparent;
  border: none;
  padding: 0;
}
.marker-callout--left .marker-card { flex-direction: row-reverse; }
.marker-photo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(58, 54, 47, 0.28); /* 极淡墨边（§27.2） */
  background: #EFE9DC;
  box-shadow: 0 0 0 4rpx rgba(248, 245, 237, 0.55); /* 极淡宣纸描边 */
}
.marker-photo--fallback { opacity: 0.8; }
.marker-callout--selected .marker-photo {
  width: 86rpx;
  height: 86rpx;
  border-color: rgba(58, 54, 47, 0.72);
}
.marker-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: transparent;
}
/* 地点名 26~28rpx/600、日期 22~24rpx（§27.4），无白色气泡 */
.marker-place {
  font-size: 27rpx;
  font-weight: 600;
  color: #302D28;
  text-shadow: 0 0 6rpx rgba(248, 245, 237, 0.9);
}
.marker-meta {
  font-size: 23rpx;
  color: #55503F;
  text-shadow: 0 0 6rpx rgba(248, 245, 237, 0.9);
}
/* 短墨线：照片下方，向下连接坐标墨点（§27.3） */
.marker-line {
  width: 2rpx;
  height: 20rpx;
  margin-top: 2rpx;
  background: rgba(58, 54, 47, 0.62);
  border-radius: 2rpx;
}

/* ---------- 空态 / 错误态（§32：小片宣纸，不用明显大白卡） ---------- */
.empty-hint {
  position: absolute;
  top: 38%;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(248, 245, 237, 0.88);
  z-index: 50;
  text-align: center;
}
.empty-title { font-size: 28rpx; color: var(--color-text-primary); font-weight: 500; }
.empty-desc { font-size: 22rpx; color: var(--color-text-muted); }

/* ---------- 定位墨圈（§29） ---------- */
.locate-btn {
  position: absolute;
  right: var(--space-4);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  padding: 0;
  border-radius: var(--radius-full);
  background: transparent;
  box-shadow: none;
  line-height: 1;
  z-index: 50;
}
.locate-btn::after { border: none; }
.locate-btn--hover { opacity: 0.8; }
.locate-btn--up {
  bottom: calc(480rpx + env(safe-area-inset-bottom));
}
.locate-btn__bg {
  position: absolute;
  inset: 0;
  width: 116rpx;
  height: 116rpx;
  pointer-events: none;
}
.locate-btn__text {
  position: relative;
  font-size: 20rpx;
  color: var(--color-text-primary);
  margin-top: 30rpx;
}

/* ---------- 底部浮动详情卡（§30：Floating Surface，高 220~232rpx，圆角 28~32rpx） ---------- */
.map-card {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: stretch;
  min-height: 226rpx;
  padding: 20rpx;
  gap: 18rpx;
  background: rgba(253, 251, 246, 0.94);
  border: 1rpx solid rgba(85, 76, 63, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 48, 38, 0.08);
  z-index: 50;
}
.card-thumb {
  flex: none;
  width: 152rpx;
  height: 186rpx;
  border-radius: var(--radius-img);
  background: #E9E2D5;
}
.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.card-headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.card-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.card-place {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-region {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-meta { font-size: 22rpx; color: var(--color-text-muted); }

/* 查看记录：墨刷按钮（§31：brush-dark 素材 + WXML 叠字，非普通圆角矩形） */
.view-record {
  flex: none;
  width: 176rpx;
  height: 60rpx;
  margin: 4rpx 0 0;
}

.preview-row {
  display: flex;
  gap: 8rpx;
  margin-top: auto;
}
.preview-img, .preview-more {
  width: 60rpx;
  height: 60rpx;
  border-radius: 10rpx;
  background: #E7E0D4;
}
.preview-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: rgba(90, 80, 64, 0.08);
}
