/* 时间线（FR-08）：水墨暖纸色，左侧日期分组 + 竖向时间轴 */

.page {
  min-height: 100vh;
  padding: var(--space-4) var(--space-4) var(--space-8);
}

/* ---------- 状态页（空态 / 网络失败） ---------- */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: var(--space-2);
}
.state-icon {
  font-size: 72rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}
.state-title {
  font-size: var(--text-lg);
  color: var(--color-text-primary);
  font-weight: 500;
}
.state-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.state-btn {
  margin-top: var(--space-5);
  width: 320rpx;
}

/* ---------- 骨架屏 ---------- */
.sk-row {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.sk-date {
  width: 96rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-subtle);
}
.sk-card {
  flex: 1;
  height: 248rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-subtle);
}

/* ---------- 时间轴 ---------- */
.tl-row {
  display: flex;
  align-items: stretch;
  margin-bottom: var(--space-4);
}

.tl-side {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--space-2);
}
.tl-year {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.3;
}
.tl-md {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}
.tl-track {
  flex: 1;
  width: 2rpx;
  margin-top: var(--space-2);
  background: var(--color-border-subtle);
  position: relative;
}
.tl-dot {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-border-control);
}

/* ---------- 左滑 ---------- */
.swipe-item {
  flex: 1;
  min-width: 0;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
}
.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 300rpx; /* 与 timeline.js ACTION_WIDTH_RPX 一致 */
  display: flex;
}
.action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  color: var(--color-action-text);
}
.action-export {
  background: var(--color-text-secondary);
}
.action-delete {
  background: #8C3B2E; /* 宣纸朱：删除的警示色（色板外单点色，见交付说明） */
}
.swipe-card {
  position: relative;
  z-index: 1;
}
.swipe-card--anim {
  transition: transform var(--duration-normal) ease-out;
}

/* ---------- footer ---------- */
.footer {
  text-align: center;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  padding: var(--space-4) 0;
}

/* ---------- 导出弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.panel {
  width: 600rpx;
  background: var(--color-bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.panel-title {
  font-size: var(--text-lg);
  font-weight: 600;
  text-align: center;
}
.panel-text {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}
.panel-btns {
  display: flex;
  gap: var(--space-3);
}
.panel-btn {
  flex: 1;
}
