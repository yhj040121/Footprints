/* 时间线：完整日期、细墨线和横版水墨记录卡；无左滑、长按或选择框。 */

.page {
  min-height: 100vh;
  padding: var(--space-4) var(--space-4) calc(240rpx + env(safe-area-inset-bottom));
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: var(--space-2);
}
.state-icon {
  font-size: 72rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}
.state-title {
  font-size: var(--text-lg);
  color: var(--color-text-primary);
  font-weight: 500;
}
.state-desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.state-btn {
  margin-top: var(--space-5);
  width: 320rpx;
}

.sk-row {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.sk-date {
  width: 56rpx;
  height: 32rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-subtle);
}
.sk-card {
  flex: 1;
  height: 248rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-subtle);
}

.tl-row {
  display: flex;
  align-items: stretch;
  margin-bottom: var(--space-4);
}
.tl-side {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 0;
}
.tl-track {
  flex: 1;
  width: 2rpx;
  background: rgb(92 84 71 / 18%);
  position: relative;
}
.tl-dot {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: #8F8777;
  box-shadow: 0 0 0 5rpx rgb(246 242 233 / 72%);
}

.tl-content {
  flex: 1;
  min-width: 0;
}

.tl-date {
  min-height: 48rpx;
  display: flex;
  align-items: flex-start;
  padding: 0 0 10rpx 8rpx;
  color: #3F3A32;
  font-size: 27rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.card-wrap {
  min-width: 0;
  border-radius: var(--radius-lg);
}

.footer {
  text-align: center;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  padding: var(--space-4) 0;
}
