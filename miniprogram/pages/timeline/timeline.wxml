<!-- 时间线 tab 页（V1.3）：窄时间线只保留节点，日期信息留在记录详情；
   卡片直接进入详情页；导出/删除入口已移除（用户拍板）。 -->
<view class="page" bindtap="onListTap">
  <image class="page-bg" src="/assets/bg/page-paper-ink.jpg" mode="aspectFill" />
  <mock-badge />

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-date"></view>
      <view class="sk-card"></view>
    </view>
  </view>

  <view wx:elif="{{loginError}}" class="state">
    <view class="state-icon">☁</view>
    <view class="state-title">网络不可用</view>
    <view class="state-desc">请检查网络后重试</view>
    <button class="fp-btn-primary state-btn" bindtap="onRetryLogin">重试</button>
  </view>

  <view wx:elif="{{list.length === 0}}" class="state">
    <view class="state-icon">✎</view>
    <view class="state-title">还没有足迹</view>
    <view class="state-desc">记下第一段「某年某月某日，我在哪里」</view>
    <button class="fp-btn-primary state-btn" bindtap="onGoAdd">去记录</button>
  </view>

  <block wx:else>
    <view class="tl-list">
      <view class="tl-row" wx:for="{{list}}" wx:key="_id">
        <view class="tl-side">
          <view class="tl-track">
            <view class="tl-dot"></view>
          </view>
        </view>

        <view class="card-wrap">
          <footprint-card
            record="{{item}}"
            cover-url="{{item.coverUrl}}"
            bind:tap="onCardTap"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="footer">加载中…</view>
    <view wx:elif="{{!hasMore && list.length > 0}}" class="footer">— 到底啦 —</view>
  </block>
</view>
