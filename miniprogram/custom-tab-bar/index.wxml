<!-- 自定义 tabBar：水墨悬浮胶囊条（按 pic 成果图样式）
     背景/图标为 pic/ SVG 预渲染 PNG（assets/tabbar/，转换脚本 tools/svg2png/convert.js） -->
<view class="tab-bar">
  <image class="tab-bar__bg" src="/assets/tabbar/nav-bg.png" mode="scaleToFill" />
  <view class="tab-bar__row">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{index === selected && !item.isCenter ? 'tab-item--active' : ''}}"
      hover-class="tab-item-hover"
      hover-stay-time="80"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view wx:if="{{item.isCenter}}" class="tab-center">
        <image class="tab-center__btn" src="/assets/tabbar/add.png" mode="aspectFit" />
      </view>
      <block wx:else>
        <image class="tab-item__icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="tab-item__text">{{item.text}}</text>
      </block>
    </view>
  </view>
</view>
