<!-- 自定义 tabBar：5 槽（时间线/日历/中央凸出「＋」/地图/我的）
     图标素材待用户提供，暂用文字 + 线性小符占位（见交付说明） -->
<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{index === selected && !item.isCenter ? 'tab-item--active' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view wx:if="{{item.isCenter}}" class="tab-center">
      <view class="tab-center-btn">＋</view>
      <text class="tab-text tab-text--center">{{item.text}}</text>
    </view>
    <block wx:else>
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-text">{{item.text}}</text>
    </block>
  </view>
</view>
