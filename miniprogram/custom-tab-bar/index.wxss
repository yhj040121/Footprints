/* 5 槽自定义 tabBar：中央凸出大按钮
   安全区只在容器上垫一次（真机 bug 修复：原 item 内重复垫安全区，
   110rpx 定高被安全区吃掉后内容只剩 ~42rpx，图标文字被裁切） */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FDFBF5;
  border-top: 1rpx solid #E2DACA;
  z-index: 100;
}

.tab-item {
  flex: 1;
  min-width: 0; /* 强制五槽等分可收缩：任何子项的 min-content 撑宽都会把最后的「我的」推出屏幕（真机 bug） */
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #9A937F;
}

.tab-item--active {
  color: #35322C;
  font-weight: 500;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
}

/* 中央凸出「＋」：按钮浮出栏顶，文字落栏内 */
.tab-center {
  position: relative;
  align-self: stretch; /* 撑满槽位宽：不用 width:100%（百分比子项会撑爆 flex 最小宽度） */
  height: 100rpx;
}

.tab-center-btn {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #35322C;
  color: #F8F4EA;
  font-size: 50rpx;
  line-height: 84rpx;
  text-align: center;
  border: 4rpx solid #FDFBF5;
}

.tab-text--center {
  position: absolute;
  bottom: 6rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #9A937F;
}
