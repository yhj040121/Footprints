/* 溪山行旅 全局样式 —— 水墨暖纸色（需求文档 V1.0 §5-§12 视觉系统）
 * 原则：宣纸、淡墨、留白；页面负责氛围、卡片负责信息、水墨只做三级视觉；
 * 阴影按 §7.2 允许轻阴影（仅浮层/独立功能入口）；朱砂仅用于小印章/危险动作/少量状态强调 */

page {
  /* 色板：暖纸色体系（§5.1 全局颜色） */
  --color-bg-page: #F6F2E9;        /* 页面宣纸底 */
  --color-bg-surface: #FDFBF5;     /* 主卡片暖白 */
  --color-bg-subtle: #F9F6EE;      /* 次级暖白 */
  --color-bg-hover: #EFE9DC;       /* 按下/悬停 */
  --color-text-primary: #302D28;   /* 主文字 */
  --color-text-secondary: #6E685C; /* 次级文字 */
  --color-text-muted: #9A937F;     /* 弱提示 */
  --color-text-disabled: #B7AF9E;  /* 禁用文字 */
  --color-border-subtle: rgba(90, 80, 64, 0.12); /* 弱边框 */
  --color-border-control: rgba(90, 80, 64, 0.20); /* 控件边框 */
  --color-action-bg: #302D28;      /* 主墨按钮 */
  --color-action-pressed: #4A463E;
  --color-action-text: #F8F4EA;    /* 按钮文字 */
  --color-accent: #A84737;         /* 朱砂：小印章/删除/少量状态强调，禁止大面积使用 */
  --color-overlay: rgb(0 0 0 / 48%);

  /* 字号刻度（rpx 以 375 屏宽为基准换算） */
  --text-xs: 24rpx;
  --text-sm: 28rpx;
  --text-base: 32rpx;
  --text-lg: 36rpx;
  --text-xl: 40rpx;
  --text-2xl: 48rpx;

  /* 间距刻度 */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;

  /* 圆角（§7.1：普通图 14~18 / 卡 24~30 / 统计大卡 30 / 浮动卡 28~32 / 胶囊 999） */
  --radius-img: 14rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-card: 26rpx;
  --radius-lg: 24rpx;
  --radius-xl: 30rpx;
  --radius-float: 30rpx;
  --radius-full: 9999rpx;

  /* 阴影（§7.2：只允许轻阴影，用于 TabBar / 浮动详情卡 / 独立功能入口） */
  --shadow-float: 0 8rpx 28rpx rgba(55, 48, 38, 0.05);
  --shadow-card: 0 8rpx 28rpx rgba(55, 48, 38, 0.04);

  /* 动效（§45.2：120~240ms，只做轻淡入/切换/选中/按下反馈） */
  --duration-fast: 120ms;
  --duration-normal: 180ms;
  --duration-slow: 240ms;

  background: var(--color-bg-page);
  color: var(--color-text-primary);
  /* §8.1 正文：系统字体；地点名称 Semibold（§8.2 禁止楷体）；书法只用于品牌素材（§8.3） */
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  font-size: var(--text-base);
  line-height: 1.5;
}

view, text, input, textarea, button, image, scroll-view, swiper {
  box-sizing: border-box;
}

/* ---------- Surface 体系（§6） ---------- */

/* Paper Surface：普通统计卡/记录卡/表单信息卡 —— 暖白、极弱边、无明显水墨、大量留白 */
.fp-card,
.surface-paper {
  background: rgba(253, 251, 246, 0.92);
  border: 1rpx solid rgba(85, 76, 63, 0.10);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* Ink Surface：我的页功能入口/特殊水墨功能卡 —— 仍以暖白为主，仅边角极淡山水 */
.surface-ink {
  position: relative;
  overflow: hidden;
  background: rgba(253, 251, 246, 0.94);
  border: 1rpx solid rgba(85, 76, 63, 0.10);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-float);
}
.surface-ink .ink-edge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 180rpx;
  height: 140rpx;
  pointer-events: none;
  opacity: 0.5;
}
.surface-ink > view,
.surface-ink > text,
.surface-ink > image:not(.ink-edge) {
  position: relative;
  z-index: 1;
}

/* Floating Surface：TabBar / 地图底部详情卡 / 页面底部操作栏 —— 半透明暖白 + 轻柔阴影 */
.surface-floating {
  background: rgba(253, 251, 246, 0.94);
  border: 1rpx solid rgba(85, 76, 63, 0.08);
  border-radius: var(--radius-float);
  box-shadow: 0 8rpx 28rpx rgba(55, 48, 38, 0.08);
}

/* ---------- 按钮 ---------- */

/* 通用主按钮（墨色） */
.fp-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-action-bg);
  color: var(--color-action-text);
  font-size: var(--text-sm);
  font-weight: 500;
  box-shadow: none;
}
.fp-btn-primary::after { border: none; }
.fp-btn-primary.button-hover { background: var(--color-action-pressed); }
.fp-btn-primary[disabled] {
  color: var(--color-text-disabled);
  background: var(--color-bg-hover);
}

/* 通用次按钮 */
.fp-btn-plain {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-surface);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border-control);
  font-size: var(--text-sm);
  box-shadow: none;
}
.fp-btn-plain::after { border: none; }
.fp-btn-plain.button-hover { background: var(--color-bg-hover); }

/* Brush Action（§6.4）：真实干笔墨块 + WXML 叠字，用于查看记录/重点跳转，不用普通圆角矩形 */
.brush-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  background: transparent;
  line-height: 1;
}
.brush-btn::after { border: none; }
.brush-btn__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.brush-btn__text {
  position: relative;
  z-index: 1;
  color: var(--color-action-text);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 标签 chip */
.fp-chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 6rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-border-control);
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}
.fp-chip--active {
  background: var(--color-action-bg);
  border-color: var(--color-action-bg);
  color: var(--color-action-text);
}
.fp-chip--disabled {
  color: var(--color-text-disabled);
  border-color: var(--color-border-subtle);
}

/* 辅助说明文字 */
.fp-hint {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
}

/* 页面背景（§12：宣纸纹理 + 极淡水墨；固定铺满，压在纸色之上、内容之下） */
.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
}
